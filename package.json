{
  "name": "@zig-zag/chains",
  "version": "1.1.0",
  "description": "A comprehensive chain registry for the Polkadot ecosystem — relay chains, system parachains, and third-party parachains with rich metadata.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigzag-js/chains.git"
  },
  "bugs": {
    "url": "https://github.com/zigzag-js/chains/issues"
  },
  "homepage": "https://github.com/zigzag-js/chains#readme",
  "author": "Yogesh Kumar (https://github.com/itsyogesh)",
  "license": "MIT",
  "keywords": [
    "polkadot",
    "substrate",
    "kusama",
    "chains",
    "web3",
    "blockchain",
    "parachain",
    "registry"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
